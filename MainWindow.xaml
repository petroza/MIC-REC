<Window x:Class="MicRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MicRec" xmlns:controls="clr-namespace:MicRec.Controls"
        Title="MicRec" Width="1100" Height="850" MinWidth="880" MinHeight="700"
        Icon="icon.ico" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded" Closing="MainWindow_OnClosing">
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="31" Background="{StaticResource AccentBrush}" Margin="0,0,13,0"/>
                <StackPanel><TextBlock Text="MICREC" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="HeaderSubtitle" Text="Prostor pro váš hlas." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="NOČNÍ STUDIO" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,0,5"/><TextBlock Text="Soustřeďte se na zvuk." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="01  /  Nahrávání">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                    <StackPanel Margin="0,18,0,0">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="VSTUPNÍ ZAŘÍZENÍ" Style="{StaticResource Caption}"/><ComboBox x:Name="DeviceCombo" DisplayMemberPath="FriendlyName" AutomationProperties.Name="Mikrofon" ToolTip="{Binding SelectedItem.FriendlyName, RelativeSource={RelativeSource Self}}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="KVALITA ZÁZNAMU" Style="{StaticResource Caption}"/><ComboBox x:Name="QualityCombo" AutomationProperties.Name="Kvalita záznamu" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Panel}" Padding="20" Background="#101214">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="M I C R E C   /   0 1" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <controls:HalEye x:Name="RecordingEye" Width="156" Height="156" AutomationProperties.Name="Zvukově reaktivní oko HAL"/>
                                    <TextBlock x:Name="StatusText" Text="Připraveno" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" HorizontalAlignment="Center" Margin="0,6"/>
                                <Grid Grid.Column="2" Margin="12,0,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="ČAS ZÁZNAMU" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="ElapsedText" Grid.Row="1" Text="00:00:00" FontFamily="Consolas" FontSize="52" Foreground="#D5D3C9" Margin="-3,0,0,16"/>
                                    <Grid Grid.Row="2" Height="85">
                                        <UniformGrid Rows="4" IsHitTestVisible="False"><Border BorderBrush="#202326" BorderThickness="0,1,0,0"/><Border BorderBrush="#202326" BorderThickness="0,1,0,0"/><Border BorderBrush="#202326" BorderThickness="0,1,0,0"/><Border BorderBrush="#202326" BorderThickness="0,1,0,1"/></UniformGrid>
                                        <Canvas x:Name="EqCanvas" ClipToBounds="True" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="SignalHint" Text="Signál se zobrazí při nahrávání" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="VSTUPNÍ SIGNÁL" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                </Grid>
                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="dBFS" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    <Grid Grid.Row="1" Height="172" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                        <Grid><TextBlock Text="0" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="−25" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="−50" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/></Grid>
                                        <Border Grid.Column="1" Background="#080A0B" CornerRadius="2"><Rectangle x:Name="MeterL" Height="0" Fill="#849785" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/></Border>
                                        <Border Grid.Column="3" Background="#080A0B" CornerRadius="2"><Rectangle x:Name="MeterR" Height="0" Fill="#849785" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/></Border>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="L    R" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,8,10,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Margin="0,14,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnStart" Content="●  Nahrávat" Style="{StaticResource PrimaryButton}" Width="158" Height="46" Click="BtnStart_Click"/>
                                <Button x:Name="BtnPause" Content="Ⅱ  Pauza" Width="132" Margin="10,0,0,0" Click="BtnPause_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStop" Content="■  Zastavit" Width="112" Margin="10,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Každý detail je slyšet." Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,18" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="250"/><ColumnDefinition Width="24"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><CheckBox x:Name="ChkLimiter" Content="Limiter / AGC" IsChecked="True" Checked="ChkLimiter_Changed" Unchecked="ChkLimiter_Changed"/><TextBlock Text="Vyrovnává hlasitost a hlídá špičky." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="28,7,0,0" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="CÍLOVÁ HLASITOST" Style="{StaticResource Caption}"/><TextBlock x:Name="TargetLabel" Text="−18 dBFS" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11"/></DockPanel><Slider x:Name="TargetSlider" Minimum="-30" Maximum="-9" Value="-18" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TargetSlider_ValueChanged" IsEnabled="{Binding IsChecked, ElementName=ChkLimiter}" AutomationProperties.Name="Cílová hlasitost v dBFS"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="ZISK AGC" Style="{StaticResource Caption}"/><TextBlock x:Name="GainText" Text="+0.0 dB" FontFamily="Consolas" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="KNIHOVNA NAHRÁVEK" Style="{StaticResource Caption}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderBox" LostFocus="OutputFolderBox_LostFocus" AutomationProperties.Name="Kořenová složka knihovny" ToolTip="Nové nahrávky se ukládají do této složky."/><Button x:Name="BtnBrowse" Grid.Column="1" Content="Vybrat složku…" Click="BtnBrowse_Click" Margin="10,0,0,0"/></Grid>
                        <TextBlock x:Name="FileText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="02  /  Knihovna"><local:LibraryPanel x:Name="LibraryTab" Margin="0,18,0,0"/></TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Grid><TextBlock Text="MICREC   /   AUDIO RECORDER" FontSize="9" Foreground="#737A77"/><TextBlock Text="Méně světla. Více soustředění." FontSize="10" Foreground="#737A77" HorizontalAlignment="Right"/></Grid>
            <TextBlock Text="© 2026 Petr Závorka" FontSize="9" Foreground="#737A77" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>



